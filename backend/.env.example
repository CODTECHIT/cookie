# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Replace with your own MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=daksha_food_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── Cloudinary (Image Uploads) ───────────────────────────────────────────────
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Frontend URL (CORS) ──────────────────────────────────────────────────────
# Production: https://www.dakshafoods.in (or http://localhost:5173 in development)
CLIENT_URL=https://www.dakshafoods.in
VITE_API_URL=https://www.dakshafoods.in/api

# ─── Razorpay (Payments) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
